{
  "name": "slack-notification",
  "version": "1.0.0",
  "description": "notification sender for my private slack ;)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "lint": "oxlint src/",
    "check": "oxfmt src/ && oxlint --fix src/"
  },
  "repository": "git+https://github.com/hikariru/slack-notification.git",
  "author": " ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hikariru/slack-notification/issues"
  },
  "homepage": "https://github.com/hikariru/slack-notification#readme",
  "dependencies": {
    "@slack/logger": "^5.0.0",
    "luxon": "^3.7.2",
    "slack-cloudflare-workers": "^1.3.10",
    "slack-web-api-client": "^1.1.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/luxon": "^3.7.6",
    "oxfmt": "^0.6.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
}
